# Required: OpenRouter API key for the vision-model analysis
OPENROUTER_API_KEY=sk-or-...

# Optional: override the analysis model (OpenRouter model id)
# OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# Postgres connection. On Vercel this is injected automatically by the
# Neon integration (DATABASE_URL / POSTGRES_URL) - set manually only for
# local `next dev` against your own Neon database.
# DATABASE_URL=postgres://...
