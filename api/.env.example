# Copy to api/.env for your own infrastructure; fill every required value.
# Docker local demo uses docker-compose.yml defaults instead of this file.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DB_HOST:5432/courtside?sslmode=require
ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_PROVIDER_KEY

# Private S3-compatible bucket. For AWS, use the bucket region (e.g. us-east-1)
# and leave S3_ENDPOINT_URL blank. Tigris uses region auto and https://t3.storage.dev.
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=REPLACE_WITH_YOUR_STORAGE_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_STORAGE_SECRET
S3_FORCE_PATH_STYLE=false
# Optional: separate public endpoint for signed URLs. Leave blank in production
# when the internal endpoint is already client-reachable. Do not rewrite signed URLs.
S3_PUBLIC_ENDPOINT_URL=

DEFAULT_MODEL=qwen/qwen3.8-27b
OPENROUTER_URL=https://openrouter.ai/api/v1
# Optional webhooks: BOTH secret and exact trusted hosts are required.
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_TIMEOUT_S=10
WEBHOOK_MAX_ATTEMPTS=5

WORK_DIR=/data/work
WORKER_CONCURRENCY=1
JOB_TIMEOUT_S=14400
HEARTBEAT_S=15
STALE_AFTER_S=120
POLL_INTERVAL_S=3
MAX_UPLOAD_BYTES=8589934592
UPLOAD_URL_TTL_S=21600
DOWNLOAD_URL_TTL_S=3600
UPLOAD_GRACE_S=86400
DEFAULT_MONTHLY_USD_CAP=50
MAX_CONCURRENT_JOBS_PER_ACCOUNT=3
DELETE_SOURCE_AFTER_ANALYSIS=true
# Comma-separated browser origins; native clients do not need CORS.
CORS_ORIGINS=
LOG_LEVEL=INFO

# Backend-supplied user identity is required for account-authenticated routes.
REQUIRE_USER_ID=true
# Restrict allowed overrides; empty means only DEFAULT_MODEL.
ALLOWED_MODELS=
MAX_PENDING_UPLOADS=20
UPLOADS_PER_HOUR=30
STARTS_PER_HOUR=30
# Require a finite provider-side API-key budget before worker startup.
REQUIRE_PROVIDER_BUDGET=true
# Held before each provider request; uncertain responses keep this reservation.
REQUEST_RESERVE_USD=0.50
# 0 preserves reports until explicit deletion; set a positive policy before production.
REPORT_RETENTION_DAYS=0
# Requires an image built with --build-arg INSTALL_POSE=true; review its licenses.
INSTALL_POSE=false
ENABLE_POSE=false
